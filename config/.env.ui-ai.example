# Example SERVER configuration, not a replacement for the repo .env.example.
# No credential in this file. OFF by default. Restart server after config change.
LLM_ENABLED=false
LLM_GATEWAY_TOKEN=

# ONE active profile, selected by operator. New config must be complete.
AI_PROFILE_ID=teaching-primary
AI_CONFIG_VERSION=1
# openai-chat-completions | anthropic-messages
AI_PROTOCOL=openai-chat-completions
# Explicit API ROOT, not full request endpoint. Includes /v1 if provider requires.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# prompt_json baseline for compatible gateways; json_object/json_schema opt-in.
AI_JSON_MODE=prompt_json
# OpenAI only: max_completion_tokens | max_tokens, send exactly one.
AI_OPENAI_TOKEN_FIELD=max_completion_tokens
# bearer | x-api-key. Anthropic official default is x-api-key.
AI_AUTH_SCHEME=bearer
AI_ANTHROPIC_VERSION=2023-06-01
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_INPUT_TOKENS=32768
# Exact trusted origin(s); path/profile validation and egress policy also required.
AI_ALLOWED_ORIGINS=https://api.openai.com
AI_ALLOW_LOCAL_DEV=false
# Optional reasoning/temperature deliberately NOT defaulted to max/1.
# Budget/pricing are provisioned separately in trusted DB policy for this profile.
# No live calls until config, budget, review and authorization gates are satisfied.

# To use native Anthropic, replace selected profile fields with:
# AI_PROTOCOL=anthropic-messages
# AI_API_BASE_URL=https://api.anthropic.com/v1
# AI_AUTH_SCHEME=x-api-key
# AI_ALLOWED_ORIGINS=https://api.anthropic.com
# AI_MODEL=<model-accessible-to-your-account>
# AI_API_KEY=<set-in-server-secret-store>
# Use AI_JSON_MODE=prompt_json unless native structured output is implemented/tested.

# To use a gateway, set its actual protocol, API root, trusted origin, model and key.
# Do not infer protocol from the model's brand. Custom path prefixes are supported.
# This file does not activate a proxy, issue keys, set prices or bypass review.
