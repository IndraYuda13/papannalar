# Konfigurasi Supabase local/dev; jangan isi secret di repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origin aplikasi untuk pemeriksaan CSRF dan redirect callback.
APP_ORIGIN=
# Secret HMAC pairing dibuat saat setup server (32+ karakter); jangan isi di repo.
PAIRING_SECRET=
# Jangan menaruh server/service-role key pada variabel NEXT_PUBLIC_*.
# AI opsional; aktif hanya setelah review konten/privasi dan budget shared DB.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
# Secret server untuk narrow budget RPC; hash diset pemilik di llm_policy.
LLM_GATEWAY_TOKEN=
# Akun contoh diprovision satu kali. Seluruh nilai berikut hanya server.
SAMPLE_ENABLED=false
SAMPLE_TEACHER_ID=
SAMPLE_TEACHER_EMAIL=
SAMPLE_TEACHER_PASSWORD=
# Minimal 12 karakter untuk origin hosted; operator memasukkan melalui form.
SAMPLE_ACCESS_CODE=

# UI/AI v2: one complete server profile. OFF above; app model must be supplied
# by the operator. The model running Codex is not an application default.
AI_PROFILE_ID=teaching-primary
AI_CONFIG_VERSION=1
AI_PROTOCOL=openai-chat-completions
AI_API_BASE_URL=https://api.openai.com/v1
AI_ALLOWED_ORIGINS=https://api.openai.com
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=prompt_json
AI_OPENAI_TOKEN_FIELD=max_completion_tokens
AI_AUTH_SCHEME=bearer
AI_ANTHROPIC_VERSION=2023-06-01
AI_MAX_INPUT_TOKENS=32768
AI_MAX_OUTPUT_TOKENS=1200
AI_ALLOW_LOCAL_DEV=false
# Native Anthropic: anthropic-messages, https://api.anthropic.com/v1,
# x-api-key, prompt_json. Change allowed origin and supply its own AI_API_KEY.
# Legacy: omit all AI_* fields and use only ANTHROPIC_API_KEY. Never mix keys.
# Matching trusted DB profile/prices/caps and real review are required separately.
