# Konfigurasi Supabase local/dev; jangan isi secret di repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origin aplikasi untuk pemeriksaan CSRF dan redirect callback.
APP_ORIGIN=
# Secret HMAC pairing dibuat saat setup server (32+ karakter); jangan isi di repo.
PAIRING_SECRET=
# Jangan menaruh server/service-role key pada variabel NEXT_PUBLIC_*.
# AI opsional; aktif hanya setelah review konten/privasi dan budget shared DB.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
# Secret server untuk narrow budget RPC; hash diset pemilik di llm_policy.
LLM_GATEWAY_TOKEN=
# Akun contoh diprovision satu kali. Seluruh nilai berikut hanya server.
SAMPLE_ENABLED=false
SAMPLE_TEACHER_ID=
SAMPLE_TEACHER_EMAIL=
SAMPLE_TEACHER_PASSWORD=
# Minimal 12 karakter untuk origin hosted; operator memasukkan melalui form.
SAMPLE_ACCESS_CODE=
